{
  "name": "@spd/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "소프트웨어 프로젝트 계획·제어 시뮬레이터 (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spd/analysis": "*",
    "@spd/models": "*",
    "@spd/sd-engine": "*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "echarts": "^6.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "author": "문성욱",
  "build": {
    "appId": "kr.spd.simulator",
    "productName": "SPD",
    "copyright": "SPD",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "SPD"
    },
    "electronVersion": "44.9.1",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
